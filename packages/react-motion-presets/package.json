{
  "name": "@jashan-randhawa/react-motion-presets",
  "version": "0.1.0",
  "description": "Framer Motion building blocks: stagger variants, rolling count-up numbers, streaming word reveal for AI responses, and collapsible containers with reduced-motion support.",
  "license": "MIT",
  "author": "Jashan Randhawa",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "framer-motion": ">=11.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jashan-randhawa/AI-FitnessTracker1.git"
  }
}
