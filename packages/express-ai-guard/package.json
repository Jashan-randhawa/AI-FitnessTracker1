{
  "name": "@jashan-randhawa/express-ai-guard",
  "version": "0.1.0",
  "description": "Express middleware bundle for AI-backed APIs: dual-tier rate limiting, request IDs, and safe error masking.",
  "license": "MIT",
  "author": "Jashan Randhawa",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "dependencies": {
    "express-rate-limit": "^7.5.0 || ^8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  }
}
