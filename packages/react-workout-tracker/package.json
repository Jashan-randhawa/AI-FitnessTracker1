{
  "name": "@jashan-randhawa/react-workout-tracker",
  "version": "0.1.0",
  "description": "Interactive workout set-logging UI and headless session hook with weight/reps tracking, rest countdown timers, and completion celebrations.",
  "license": "MIT",
  "author": "Jashan Randhawa",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "canvas-confetti": ">=1.9.0",
    "framer-motion": ">=11.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "canvas-confetti": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jashan-randhawa/AI-FitnessTracker1.git"
  }
}
