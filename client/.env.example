# VITE_ variables are public in the browser bundle. Never put secrets here.

# Backend API base URL (Express + MongoDB).
# Local development: http://localhost:1337
# Production (e.g. Render): https://your-backend-app.onrender.com
# Trailing slash is optional (trimmed automatically by the client API config).
VITE_API_URL=http://localhost:1337

# Note on External APIs:
# - Weather data comes from Open-Meteo (https://open-meteo.com) - free, no key required.
# - YouTube workout video search runs through the backend proxy (/api/youtube/search).
# - AI Workout Suggestions call the backend endpoint (/api/ai-assistant/chat).
# All private keys (RAPIDAPI_KEY, OPENROUTER_API_KEY, GEMINI_API_KEY) belong in server/.env only.
