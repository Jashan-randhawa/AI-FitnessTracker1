{
  "name": "fittrack-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "FitTrack AI Monorepo - Reusable modular AI and Fitness packages",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=@jashan-randhawa/openrouter-resilient-client --workspace=@jashan-randhawa/express-ai-guard --workspace=@jashan-randhawa/react-calendar-heatmap-streaks --workspace=@jashan-randhawa/react-workout-tracker --workspace=@jashan-randhawa/react-motion-presets --workspace=@jashan-randhawa/fitness-utils --workspace=@jashan-randhawa/ai-nutrition-estimator",
    "build:apps": "npm run build --workspace=client",
    "build": "npm run build:packages && npm run build:apps",
    "test:packages": "npm run test --workspace=@jashan-randhawa/openrouter-resilient-client --workspace=@jashan-randhawa/express-ai-guard --workspace=@jashan-randhawa/react-calendar-heatmap-streaks --workspace=@jashan-randhawa/react-workout-tracker --workspace=@jashan-randhawa/react-motion-presets --workspace=@jashan-randhawa/fitness-utils --workspace=@jashan-randhawa/ai-nutrition-estimator",
    "test:apps": "npm run test --workspace=server",
    "test": "npm run test:packages && npm run test:apps",
    "lint": "npm run lint --workspaces --if-present",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "framer-motion": "^12.4.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
