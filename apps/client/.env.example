# Backend API base URL (Express + MongoDB).
# Trailing slash is optional (trimmed automatically by the client API config).
VITE_API_URL=http://localhost:1337

# RapidAPI key for YouTube workout proxy
VITE_RAPIDAPI_KEY=your_rapidapi_key

# Weather data comes from Open-Meteo (https://open-meteo.com) - free, no key required.
# The AI Workout Suggestion feature calls the backend's /api/ai-assistant/chat
# endpoint, which uses OPENROUTER_API_KEY set in server/.env - no key needed here.
