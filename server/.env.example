# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337
NODE_ENV=development
LOG_LEVEL=info # debug, info, warn, error

# ── MongoDB ─────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/fittrack
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fittrack
MONGODB_URI=mongodb://127.0.0.1:27017/fittrack

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d
# Optional (default: 15m). Lifetime for short-lived access JWTs.
JWT_ACCESS_EXPIRES_IN=15m
# Optional (default: lax). SameSite attribute for httpOnly refresh token cookie (lax, strict, none).
REFRESH_TOKEN_SAMESITE=lax
# Optional (default: 30). Refresh token validity lifetime in days.
REFRESH_TOKEN_EXPIRES_DAYS=30
# Optional (default: true in production, false otherwise). Whether refresh cookie enforces HTTPS.
REFRESH_TOKEN_SECURE=false
# Optional (default: /api/auth). Scoped cookie URL path for refresh tokens.
REFRESH_TOKEN_COOKIE_PATH=/api/auth

# ── AI Assistant (OpenRouter) ───────────────────────────────
# Used by ai-assistant chat, image-analysis, calorie-estimate, food-estimate
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-001
# Optional (default: 15000). Upstream HTTP timeout in milliseconds for OpenRouter requests.
OPENROUTER_TIMEOUT_MS=15000

# ── Google Gemini AI ────────────────────────────────────────
# Required for Food Snap v2 vision analysis, FitBot agentic tools, and hands-free voice gym logging
# Get an API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional alias:
# GOOGLE_API_KEY=your_gemini_api_key
# Optional (default: gemini-2.5-flash). Gemini model for chat completions and coaching.
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Optional (default: gemini-2.5-flash). Gemini multimodal vision model for meal photo analysis.
GEMINI_VISION_MODEL=gemini-2.5-flash

# ── Google OAuth (Sign in with Google) ─────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must be registered in Google Cloud Console as an authorized redirect URI.
# Point it at THIS server, not the frontend.
GOOGLE_CALLBACK_URL=http://localhost:1337/api/connect/google/callback

# ── NewsAPI (live health headlines) ────────────────────────
NEWS_API_KEY=your_newsapi_key

# ── RapidAPI (YouTube138 — workout video search) ───────────
RAPIDAPI_KEY=your_rapidapi_key

# ── Frontend origin ─────────────────────────────────────────
# Used for CORS and for building password-reset / OAuth redirect links
CLIENT_URL=http://localhost:5173

# ── Outgoing Email — Brevo (Transactional Email API via HTTPS) ──
# 1. Generate an API Key at: https://app.brevo.com/settings/keys/api
# 2. Add hosting egress IP to authorized IPs if IP restriction is enabled
# 3. Ensure sender email matches your verified Brevo sender
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM="AI Fitness Tracker" <jashanpreetsinghrandhawa65@gmail.com>
# Optional (default: false). When "true", adds "X-Sib-Sandbox: drop" header to Brevo API calls to drop test emails.
BREVO_SANDBOX=false

# ── Redis (Distributed Caching & Rate Limiting) ──────────────
# Optional: if omitted, rate limiters gracefully fallback to resilient in-memory storage.
# E.g. redis://127.0.0.1:6379 or rediss://default:<password>@<host>:<port>
REDIS_URL=

# ── Observability & Webhook Security ──────────────────────────
# Secret token to protect the GET /metrics endpoint from unauthorized scraping
METRICS_TOKEN=

# Secret key configured in Brevo webhook settings to authenticate incoming webhook deliveries
BREVO_WEBHOOK_KEY=

# ── AI Caching, Token & Concurrency Tuning ───────────────────
# Optional (default: 300000). FitBot in-memory response cache TTL in milliseconds (5 minutes).
AI_CACHE_TTL_MS=300000
# Optional (default: 200). Maximum number of entries stored in the FitBot LRU cache.
AI_CACHE_MAX_ENTRIES=200
# Optional (default: 2500). Max output token ceiling for AI completion responses.
AI_MAX_OUTPUT_TOKENS=2500
# Optional (default: 25). Maximum concurrent AI requests processed by the server globally.
MAX_CONCURRENT_AI_REQUESTS=25
# Optional (default: 2). Maximum concurrent AI requests allowed per user account.
MAX_USER_CONCURRENT_AI_REQUESTS=2

# ── Environment & Weather Standards ──────────────────────────
# Optional (default: us_epa). Air Quality Index calculation standard (us_epa, european).
AQI_STANDARD=us_epa

# ── Startup & CI Verification ────────────────────────────────
# Optional (default: false). When "true", requires GEMINI_API_KEY / GOOGLE_API_KEY in production.
STRICT_AI_KEYS=false
# Optional (default: false). When "true", bypasses database and external service requirements for smoke testing.
CI_DRY_RUN=false
