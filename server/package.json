{
  "name": "server",
  "version": "2.6.0",
  "private": true,
  "description": "AI Fitness Tracker API — Express + MongoDB (MERN) backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/services/seed.service.js",
    "test": "node scripts/ci-guard-email.js && node --test test/*.test.js",
    "test:coverage": "node scripts/ci-guard-email.js && node -e \"fs.mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/config/db.js\" --test-coverage-exclude=\"src/services/seed.service.js\" --test-coverage-lines=82 --test-coverage-branches=72 --test-coverage-functions=72 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.js",
    "test:smoke": "node scripts/smoke-test.js",
    "ci:guard": "node scripts/ci-guard-email.js",
    "test:email": "node scripts/test-email.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
