{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["fitness", "nutrition", "health", "wellness"],
      "required": true,
      "default": "fitness"
    },
    "coverEmoji": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "default": "FitTrack Team"
    },
    "readTime": {
      "type": "integer",
      "default": 5
    },
    "tags": {
      "type": "string"
    }
  }
}
